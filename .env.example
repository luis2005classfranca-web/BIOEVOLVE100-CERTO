# Gemini AI API Key (IMPORTANTE: Adicione sua chave real no menu CONFIGURAÇÕES do AI Studio)
# O app tentará usar GEMINI_KEY primeiro, depois GEMINI_API_KEY.
GEMINI_KEY=
GEMINI_API_KEY=

# Supabase Configuration (USADAS NO CLIENTE - Vite)
# No Vercel, declare com o prefixo VITE_ exatamente como abaixo:
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon"

# App URL (Referência para o Redirect do Supabase)
APP_URL="https://seu-app.vercel.app"
