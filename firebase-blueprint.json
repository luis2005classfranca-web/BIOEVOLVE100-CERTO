{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Core user data and health score",
      "type": "object",
      "properties": {
        "bioScore": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "Onboarding": {
      "title": "Onboarding Data",
      "description": "Initial health data provided during onboarding",
      "type": "object",
      "properties": {
        "age": { "type": "number" },
        "weight": { "type": "number" },
        "onboardingComplete": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["onboardingComplete"]
    },
    "ExamRecord": {
      "title": "Exam Record",
      "description": "Extracted laboratory exam data",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "analyte": { "type": "string" },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "referenceRange": { "type": "string" },
        "label": { "type": "string" },
        "confidence": { "type": "number" },
        "isCalculated": { "type": "boolean" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "analyte", "value", "unit"]
    },
    "WearableData": {
      "title": "Wearable Data",
      "description": "Biometric data from wearable devices",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "steps": { "type": "number" },
        "heartRate": { "type": "number" }
      },
      "required": ["timestamp", "steps", "heartRate"]
    },
    "HealthInsight": {
      "title": "Health Insight",
      "description": "AI-generated health advice",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "text": { "type": "string" },
        "actionableTip": { "type": "string" }
      },
      "required": ["timestamp", "text", "actionableTip"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Main user document"
    },
    "users/{userId}/profile/initial": {
      "schema": "Onboarding",
      "description": "Initial onboarding setup"
    },
    "users/{userId}/exams/{examId}": {
      "schema": "ExamRecord",
      "description": "Collection of user health exams"
    },
    "users/{userId}/wearableData/{dataId}": {
      "schema": "WearableData",
      "description": "Wearable sync data"
    },
    "users/{userId}/insights/{insightId}": {
      "schema": "HealthInsight",
      "description": "Personalized health insights"
    }
  }
}
